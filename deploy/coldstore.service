[Unit]
Description=Cold Storage Equipment Archive System
After=network.target

[Service]
Type=simple
# 按实际部署路径与运行用户修改
User=node
WorkingDirectory=/opt/coldstore-archive
EnvironmentFile=/opt/coldstore-archive/.env
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3
StandardOutput=append:/var/log/coldstore/app.log
StandardError=append:/var/log/coldstore/app.log

[Install]
WantedBy=multi-user.target
