# 服务监听
PORT=3000
HOST=0.0.0.0

# 会话密钥：生产环境务必改成 32 位以上随机字符串，例如 openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# 若部署在 HTTPS 反向代理之后，设为 true 使 Cookie 仅走加密连接
COOKIE_SECURE=false

# 数据与上传目录（默认为项目下 data / uploads，建议生产环境指向独立数据盘）
# DATA_DIR=/var/lib/coldstore/data
# UPLOAD_DIR=/var/lib/coldstore/uploads
